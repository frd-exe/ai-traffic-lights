{
  "$defs": {
    "AiResetResponse": {
      "additionalProperties": false,
      "properties": {
        "calls_today": {
          "minimum": 0,
          "title": "Calls Today",
          "type": "integer"
        },
        "daily_cap": {
          "minimum": 0,
          "title": "Daily Cap",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "reset": {
          "title": "Reset",
          "type": "boolean"
        }
      },
      "required": [
        "reset",
        "message",
        "calls_today",
        "daily_cap"
      ],
      "title": "AiResetResponse",
      "type": "object"
    },
    "Approach": {
      "additionalProperties": false,
      "properties": {
        "bearing": {
          "description": "direction FROM the intersection TOWARD the upstream end of in_edge",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Bearing",
          "type": "number"
        },
        "id": {
          "description": "a_ + sha1(intersection_id:bearing_rounded_5deg)[:8]",
          "title": "Id",
          "type": "string"
        },
        "in_edge": {
          "title": "In Edge",
          "type": "string"
        },
        "lanes": {
          "minimum": 1,
          "title": "Lanes",
          "type": "integer"
        },
        "out_edges": {
          "description": "edges a vehicle on this approach may take (no U-turns)",
          "items": {
            "type": "string"
          },
          "title": "Out Edges",
          "type": "array"
        }
      },
      "required": [
        "id",
        "bearing",
        "lanes",
        "in_edge",
        "out_edges"
      ],
      "title": "Approach",
      "type": "object"
    },
    "ApproachObservation": {
      "additionalProperties": false,
      "properties": {
        "arrival_rate": {
          "description": "veh/s, trailing 60 sim-s",
          "minimum": 0,
          "title": "Arrival Rate",
          "type": "number"
        },
        "downstream_vehicles": {
          "default": 0.0,
          "description": "mean vehicle count on this approach's out-edges (v0.3.0; max-pressure downstream count)",
          "minimum": 0,
          "title": "Downstream Vehicles",
          "type": "number"
        },
        "queue": {
          "description": "stopped vehicles within 50 m of stop line",
          "minimum": 0,
          "title": "Queue",
          "type": "integer"
        },
        "vehicles": {
          "default": 0,
          "description": "all vehicles on the in-edge, moving or stopped (v0.3.0; max-pressure upstream count)",
          "minimum": 0,
          "title": "Vehicles",
          "type": "integer"
        },
        "wait_s": {
          "description": "longest current continuous stopped time on this approach",
          "minimum": 0,
          "title": "Wait S",
          "type": "number"
        }
      },
      "required": [
        "queue",
        "wait_s",
        "arrival_rate"
      ],
      "title": "ApproachObservation",
      "type": "object"
    },
    "AreaRequest": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "demo_city": {
          "default": false,
          "description": "ignore bbox, return the synthetic grid demo city (v0.2.0)",
          "title": "Demo City",
          "type": "boolean"
        },
        "ignore_osm_signals": {
          "default": false,
          "title": "Ignore Osm Signals",
          "type": "boolean"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "AreaRequest",
      "type": "object"
    },
    "AreaResponse": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "title": "Area Id",
          "type": "string"
        },
        "intersections": {
          "description": "ranked: best signal candidates first",
          "items": {
            "$ref": "#/$defs/Intersection"
          },
          "title": "Intersections",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/RoadNetwork"
        },
        "recommended_ids": {
          "description": "default selection for the UI",
          "items": {
            "type": "string"
          },
          "title": "Recommended Ids",
          "type": "array"
        },
        "source": {
          "description": "synthetic_grid = demo city; osm = parsed OpenStreetMap data (v0.2.0)",
          "enum": [
            "synthetic_grid",
            "osm"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "area_id",
        "source",
        "network",
        "intersections"
      ],
      "title": "AreaResponse",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "BBox",
      "type": "object"
    },
    "ControllerStatus": {
      "additionalProperties": false,
      "properties": {
        "calls_last_min": {
          "minimum": 0,
          "title": "Calls Last Min",
          "type": "integer"
        },
        "calls_today": {
          "minimum": 0,
          "title": "Calls Today",
          "type": "integer"
        },
        "daily_cap": {
          "minimum": 0,
          "title": "Daily Cap",
          "type": "integer"
        },
        "effective_controller": {
          "enum": [
            "gemini+max_pressure",
            "fixed",
            "webster",
            "max_pressure"
          ],
          "title": "Effective Controller",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "since_t": {
          "description": "sim time when this state began",
          "minimum": 0,
          "title": "Since T",
          "type": "number"
        },
        "state": {
          "enum": [
            "ai_active",
            "ai_limit_reached",
            "ai_unavailable",
            "ai_replay",
            "traditional"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "effective_controller",
        "message",
        "since_t",
        "calls_last_min",
        "calls_today",
        "daily_cap"
      ],
      "title": "ControllerStatus",
      "type": "object"
    },
    "DataStatus": {
      "additionalProperties": false,
      "properties": {
        "calls_today": {
          "minimum": 0,
          "title": "Calls Today",
          "type": "integer"
        },
        "daily_cap": {
          "minimum": 0,
          "title": "Daily Cap",
          "type": "integer"
        },
        "last_update": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "when the underlying traffic data was produced; null for simulated demand",
          "title": "Last Update"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "state": {
          "enum": [
            "google_live",
            "google_cached",
            "google_snapshot",
            "baseline_only"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "message",
        "last_update",
        "calls_today",
        "daily_cap"
      ],
      "title": "DataStatus",
      "type": "object"
    },
    "DemandEntry": {
      "additionalProperties": false,
      "properties": {
        "congestion_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "reserved for external traffic data; always null since v0.2.0",
          "title": "Congestion Ratio"
        },
        "entry_node_id": {
          "title": "Entry Node Id",
          "type": "string"
        },
        "scale": {
          "description": "entry flow = scale * LEVEL_FLOW_VEH_PER_H['medium'] (veh/h)",
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "entry_node_id",
        "scale"
      ],
      "title": "DemandEntry",
      "type": "object"
    },
    "DemandProfile": {
      "additionalProperties": false,
      "description": "Resolved ONCE and frozen; sessions reference it by id.",
      "properties": {
        "area_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "departure_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Time"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DemandEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "entry_overrides": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "maximum": 5.0,
            "type": "number"
          },
          "description": "per-entry scale factor on top of level x multiplier (v0.2.0)",
          "title": "Entry Overrides",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "rush"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set for baseline_only",
          "title": "Level"
        },
        "multiplier": {
          "default": 1.0,
          "description": "global demand multiplier (v0.2.0)",
          "maximum": 3.0,
          "minimum": 0.2,
          "title": "Multiplier",
          "type": "number"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "profile this one was derived from by /api/sim/demand (v0.2.0)",
          "title": "Parent Id"
        },
        "source": {
          "enum": [
            "google_live",
            "google_cached",
            "google_snapshot",
            "baseline_only"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "created_at",
        "entries"
      ],
      "title": "DemandProfile",
      "type": "object"
    },
    "DemandResolveRequest": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "title": "Area Id",
          "type": "string"
        },
        "departure_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Time"
        },
        "entry_overrides": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "maximum": 5.0,
            "type": "number"
          },
          "description": "{entry_node_id: scale factor} (v0.2.0)",
          "title": "Entry Overrides",
          "type": "object"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "rush"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "baseline level; default medium",
          "title": "Level"
        },
        "multiplier": {
          "default": 1.0,
          "description": "global demand multiplier (v0.2.0)",
          "maximum": 3.0,
          "minimum": 0.2,
          "title": "Multiplier",
          "type": "number"
        },
        "source": {
          "default": "baseline",
          "description": "only 'baseline' is accepted since v0.2.0; google_* are reserved and rejected",
          "enum": [
            "google_live",
            "google_snapshot",
            "baseline"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "area_id"
      ],
      "title": "DemandResolveRequest",
      "type": "object"
    },
    "DemandResolveResponse": {
      "additionalProperties": false,
      "properties": {
        "data_status": {
          "$ref": "#/$defs/DataStatus"
        },
        "demand_profile": {
          "$ref": "#/$defs/DemandProfile"
        }
      },
      "required": [
        "demand_profile",
        "data_status"
      ],
      "title": "DemandResolveResponse",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "Directed road segment from_node -> to_node.",
      "properties": {
        "from_node": {
          "title": "From Node",
          "type": "string"
        },
        "geometry": {
          "items": {
            "description": "[lon, lat]",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Geometry",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lanes": {
          "minimum": 1,
          "title": "Lanes",
          "type": "integer"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "road_class": {
          "enum": [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "unclassified",
            "residential",
            "living_street",
            "service"
          ],
          "title": "Road Class",
          "type": "string"
        },
        "speed_limit": {
          "description": "m/s",
          "exclusiveMinimum": 0,
          "title": "Speed Limit",
          "type": "number"
        },
        "to_node": {
          "title": "To Node",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from_node",
        "to_node",
        "geometry",
        "length_m",
        "speed_limit",
        "lanes",
        "road_class"
      ],
      "title": "Edge",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "machine-readable, snake_case, e.g. unknown_session",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "Body of every non-2xx REST response and of WS error frames.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "intersection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = session-wide (e.g. AI fallback notice)",
          "title": "Intersection Id"
        },
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "t",
        "intersection_id",
        "text"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "GeocodeResponse": {
      "additionalProperties": false,
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/GeocodeResult"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "title": "GeocodeResponse",
      "type": "object"
    },
    "GeocodeResult": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "display_name",
        "lat",
        "lon"
      ],
      "title": "GeocodeResult",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "default": "0.3.1",
          "title": "Contract Version",
          "type": "string"
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "Intersection": {
      "additionalProperties": false,
      "properties": {
        "approaches": {
          "items": {
            "$ref": "#/$defs/Approach"
          },
          "title": "Approaches",
          "type": "array"
        },
        "has_signal_in_osm": {
          "title": "Has Signal In Osm",
          "type": "boolean"
        },
        "id": {
          "description": "i_ + sha1(lat5,lon5)[:8]",
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "sim_gain_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "estimated delay saved by signalising (s); null until computed",
          "title": "Sim Gain S"
        },
        "structural_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Structural Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "node_id",
        "lat",
        "lon",
        "approaches",
        "has_signal_in_osm",
        "structural_score"
      ],
      "title": "Intersection",
      "type": "object"
    },
    "IntersectionObservation": {
      "additionalProperties": false,
      "properties": {
        "approaches": {
          "additionalProperties": {
            "$ref": "#/$defs/ApproachObservation"
          },
          "title": "Approaches",
          "type": "object"
        },
        "current_phase": {
          "title": "Current Phase",
          "type": "string"
        },
        "is_transition": {
          "default": false,
          "title": "Is Transition",
          "type": "boolean"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "title": "Phases",
          "type": "array"
        },
        "time_in_phase_s": {
          "minimum": 0,
          "title": "Time In Phase S",
          "type": "number"
        }
      },
      "required": [
        "phases",
        "current_phase",
        "time_in_phase_s",
        "approaches"
      ],
      "title": "IntersectionObservation",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "description": "See CONTRACT.md 'Metric definitions'; identical in engine, experiments and UI.",
      "properties": {
        "avg_queue": {
          "minimum": 0,
          "title": "Avg Queue",
          "type": "number"
        },
        "avg_wait_s": {
          "minimum": 0,
          "title": "Avg Wait S",
          "type": "number"
        },
        "blocked_spawns": {
          "minimum": 0,
          "title": "Blocked Spawns",
          "type": "integer"
        },
        "deadlocks": {
          "minimum": 0,
          "title": "Deadlocks",
          "type": "integer"
        },
        "effective_controller": {
          "enum": [
            "gemini+max_pressure",
            "fixed",
            "webster",
            "max_pressure"
          ],
          "title": "Effective Controller",
          "type": "string"
        },
        "mode": {
          "enum": [
            "fixed",
            "webster",
            "max_pressure",
            "ai"
          ],
          "title": "Mode",
          "type": "string"
        },
        "population": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "vehicles in the metric population",
          "title": "Population"
        },
        "t": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sim time the metrics refer to",
          "title": "T"
        },
        "throughput_per_min": {
          "minimum": 0,
          "title": "Throughput Per Min",
          "type": "number"
        },
        "trip_delay_s": {
          "minimum": 0,
          "title": "Trip Delay S",
          "type": "number"
        }
      },
      "required": [
        "mode",
        "effective_controller",
        "trip_delay_s",
        "avg_wait_s",
        "avg_queue",
        "throughput_per_min",
        "blocked_spawns",
        "deadlocks"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "MetricsResponse": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "t": {
          "minimum": 0,
