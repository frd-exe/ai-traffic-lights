{
  "additionalProperties": false,
  "properties": {
    "area_id": {
      "title": "Area Id",
      "type": "string"
    },
    "departure_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Departure Time"
    },
    "entry_overrides": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "maximum": 5.0,
        "type": "number"
      },
      "description": "{entry_node_id: scale factor} (v0.2.0)",
      "title": "Entry Overrides",
      "type": "object"
    },
    "level": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high",
            "rush"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "baseline level; default medium",
      "title": "Level"
    },
    "multiplier": {
      "default": 1.0,
      "description": "global demand multiplier (v0.2.0)",
      "maximum": 3.0,
      "minimum": 0.2,
      "title": "Multiplier",
      "type": "number"
    },
    "source": {
      "default": "baseline",
      "description": "only 'baseline' is accepted since v0.2.0; google_* are reserved and rejected",
      "enum": [
        "google_live",
        "google_snapshot",
        "baseline"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "area_id"
  ],
  "title": "DemandResolveRequest",
  "type": "object"
}
