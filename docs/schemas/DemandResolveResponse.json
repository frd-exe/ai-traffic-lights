{
  "$defs": {
    "DataStatus": {
      "additionalProperties": false,
      "properties": {
        "calls_today": {
          "minimum": 0,
          "title": "Calls Today",
          "type": "integer"
        },
        "daily_cap": {
          "minimum": 0,
          "title": "Daily Cap",
          "type": "integer"
        },
        "last_update": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "when the underlying Google data was fetched",
          "title": "Last Update"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "state": {
          "enum": [
            "google_live",
            "google_cached",
            "google_snapshot",
            "baseline_only"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "message",
        "last_update",
        "calls_today",
        "daily_cap"
      ],
      "title": "DataStatus",
      "type": "object"
    },
    "DemandEntry": {
      "additionalProperties": false,
      "properties": {
        "congestion_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Google duration / staticDuration; null for baseline_only",
          "title": "Congestion Ratio"
        },
        "entry_node_id": {
          "title": "Entry Node Id",
          "type": "string"
        },
        "scale": {
          "description": "multiplies the base (medium) per-entry flow",
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "entry_node_id",
        "scale"
      ],
      "title": "DemandEntry",
      "type": "object"
    },
    "DemandProfile": {
      "additionalProperties": false,
      "description": "Resolved ONCE and frozen; sessions reference it by id.",
      "properties": {
        "area_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "departure_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Time"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DemandEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "rush"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set for baseline_only",
          "title": "Level"
        },
        "source": {
          "enum": [
            "google_live",
            "google_cached",
            "google_snapshot",
            "baseline_only"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "created_at",
        "entries"
      ],
      "title": "DemandProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_status": {
      "$ref": "#/$defs/DataStatus"
    },
    "demand_profile": {
      "$ref": "#/$defs/DemandProfile"
    }
  },
  "required": [
    "demand_profile",
    "data_status"
  ],
  "title": "DemandResolveResponse",
  "type": "object"
}
