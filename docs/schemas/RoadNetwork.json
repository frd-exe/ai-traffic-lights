{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "Directed road segment from_node -> to_node.",
      "properties": {
        "from_node": {
          "title": "From Node",
          "type": "string"
        },
        "geometry": {
          "items": {
            "description": "[lon, lat]",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Geometry",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lanes": {
          "minimum": 1,
          "title": "Lanes",
          "type": "integer"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "road_class": {
          "enum": [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "unclassified",
            "residential",
            "living_street",
            "service"
          ],
          "title": "Road Class",
          "type": "string"
        },
        "speed_limit": {
          "description": "m/s",
          "exclusiveMinimum": 0,
          "title": "Speed Limit",
          "type": "number"
        },
        "to_node": {
          "title": "To Node",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from_node",
        "to_node",
        "geometry",
        "length_m",
        "speed_limit",
        "lanes",
        "road_class"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "id",
        "lat",
        "lon"
      ],
      "title": "Node",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/BBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "entry_nodes": {
      "description": "boundary nodes where vehicles spawn",
      "items": {
        "type": "string"
      },
      "title": "Entry Nodes",
      "type": "array"
    },
    "exit_nodes": {
      "description": "boundary nodes where vehicles leave",
      "items": {
        "type": "string"
      },
      "title": "Exit Nodes",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "edges",
    "entry_nodes",
    "exit_nodes"
  ],
  "title": "RoadNetwork",
  "type": "object"
}
