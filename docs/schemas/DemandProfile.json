{
  "$defs": {
    "DemandEntry": {
      "additionalProperties": false,
      "properties": {
        "congestion_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "reserved for external traffic data; always null since v0.2.0",
          "title": "Congestion Ratio"
        },
        "entry_node_id": {
          "title": "Entry Node Id",
          "type": "string"
        },
        "scale": {
          "description": "entry flow = scale * LEVEL_FLOW_VEH_PER_H['medium'] (veh/h)",
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "entry_node_id",
        "scale"
      ],
      "title": "DemandEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resolved ONCE and frozen; sessions reference it by id.",
  "properties": {
    "area_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "departure_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Departure Time"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/DemandEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "entry_overrides": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "maximum": 5.0,
        "type": "number"
      },
      "description": "per-entry scale factor on top of level x multiplier (v0.2.0)",
      "title": "Entry Overrides",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "level": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high",
            "rush"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "set for baseline_only",
      "title": "Level"
    },
    "multiplier": {
      "default": 1.0,
      "description": "global demand multiplier (v0.2.0)",
      "maximum": 3.0,
      "minimum": 0.2,
      "title": "Multiplier",
      "type": "number"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "profile this one was derived from by /api/sim/demand (v0.2.0)",
      "title": "Parent Id"
    },
    "source": {
      "enum": [
        "google_live",
        "google_cached",
        "google_snapshot",
        "baseline_only"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "created_at",
    "entries"
  ],
  "title": "DemandProfile",
  "type": "object"
}
