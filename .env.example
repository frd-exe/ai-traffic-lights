# Copy to .env and fill in. Never commit .env.

# --- Gemini (AI supervisor) ---
GEMINI_API_KEY=
# gemini-2.5-flash is no longer offered to new users; flash-lite measured 2.5 s/call (3.8-flash ~14 s)
GEMINI_MODEL=gemini-3.5-flash-lite
# Our own daily call cap; reaching it triggers the AI-limit fallback (fixed timers).
GEMINI_DAILY_CAP=500
# Testing without network: 0 = off; limit (=429 RESOURCE_EXHAUSTED); invalid (= invalid API key);
# timeout; 5xx; badjson (= invalid model output). Aliases: 429 -> limit, key -> invalid.
GEMINI_FAKE_FAIL=0
# Wall-clock seconds between supervisor calls (min 6) and max calls per minute (free tier is ~10)
GEMINI_MIN_INTERVAL_S=6
GEMINI_RPM=10
# Gemini 3.x: thinking level (low = fastest accepted; "minimal" is rejected). Gemini 2.x: thinking budget (0 = off)
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0
# Rehearsals: record plans to a JSONL file, or replay them without calling the API (state ai_replay)
AI_RECORD=
AI_REPLAY=

# --- Reserved / unused since contract 0.2.0 (demand is simulated; no external traffic data) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_DAILY_CAP=200
GOOGLE_FAKE_FAIL=0

# --- OpenStreetMap (scripts/fetch_sample_area.py, geocoding) ---
# Comma-separated Overpass endpoints tried in turn (default: overpass-api.de + mirrors, see docs/DATA_SOURCES.md)
OVERPASS_ENDPOINTS=
# Contact (email or URL) sent in the User-Agent, as the Overpass / Nominatim usage policies ask
OVERPASS_CONTACT=
NOMINATIM_CONTACT=
