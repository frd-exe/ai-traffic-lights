# Copy to .env and fill in. Never commit .env.

# --- Gemini (AI supervisor) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Our own daily call cap; reaching it triggers the AI-limit fallback (fixed timers).
GEMINI_DAILY_CAP=500
# Testing: 0 = off; "429" = simulate RESOURCE_EXHAUSTED; "timeout" / "5xx" / "invalid" = simulate failures; "key" = invalid key
GEMINI_FAKE_FAIL=0

# --- Google Maps Platform (Routes API congestion) ---
GOOGLE_MAPS_API_KEY=
# Our own daily call cap for Routes API calls (persisted counter).
GOOGLE_DAILY_CAP=200
# Testing: 0 = off; 1 = every live call fails (forces the cached -> snapshot -> baseline chain)
GOOGLE_FAKE_FAIL=0
